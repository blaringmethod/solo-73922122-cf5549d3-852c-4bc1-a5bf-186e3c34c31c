      }
    },
    {
      "table": "dim_item",
      "rows": 6,
      "ranges": {
        "item_id": {"low": 1, "high": 100},
        "wh_id":   {"low": 1, "high": 3},
        "sku":     {"low": 1000, "high": 9999}
      }
    }
  ]
